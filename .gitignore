# Environment / secrets — never commit
.env
.env.*
!.env.example

# Runtime config (contains API keys, regenerated by load_or_create_config)
config.json
weixin_state.json
# 多用户模式：每个 user 各自一份 config_<name>.json / weixin_state_<name>.json
# 也都含 API key / bot_token，绝不入库
config_*.json
weixin_state_*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime state
*.log
*.log.*
*.pid
*.sock
nohup.out

# PyInstaller build artifacts (spec files in repo root, output ignored)
dist/
build/
*.spec.bak