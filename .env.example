# =============================================================================
# ilink_bot .env 模板（真实值不入库；复制为 .env 后按下方注释填全）
# 启动前 source 一下：set -a; source .env; set +a; ./bin/server -config config.local.yaml
# =============================================================================

# ---- 服务端 ----
ILINK_SERVER_ADDR=
ILINK_SERVER_MODE=

# ---- 腾讯 ima 知识库 OpenAPI（重要：与微信 APP_ID/API_KEY 无关，别看错）----
# 凭据来源：https://ima.qq.com/agent-interface  登录 → 创建智能体 → 拿 Client ID + API Key
# 任一为空时检索自动降级为无上下文，不影响服务启动
IMA_ILINK_BASE_URL=
IMA_ILINK_CLIENT_ID=
IMA_ILINK_API_KEY=
IMA_ILINK_DEFAULT_KB=
IMA_ILINK_TIMEOUT=
IMA_ILINK_SEARCH_LIMIT=

# ---- 内部 API 鉴权 ----
ILINK_AUTH_API_TOKEN=
ILINK_AUTH_BRIDGE_TOKEN=

# ---- 微信通道 ----
ILINK_WECHAT_DRIVER=

# official 驱动
ILINK_WECHAT_APP_ID=
ILINK_WECHAT_APP_SECRET=
ILINK_WECHAT_TOKEN=
ILINK_WECHAT_ENCODING_AES_KEY=

# ilink 驱动
ILINK_ILINK_BASE_URL=
ILINK_ILINK_TOKEN=
ILINK_ILINK_BOT_AGENT=
ILINK_ILINK_STATE_PATH=
ILINK_ILINK_ALLOW_LOGIN_FLOW=

# ---- 问答引擎 ----
ILINK_BRAIN_DRIVER=
ILINK_BRAIN_ENDPOINT=
ILINK_BRAIN_TOKEN=
ILINK_BRAIN_MODEL=

# ---- 会话存储 ----
ILINK_STORE_DRIVER=
ILINK_STORE_SQLITE_PATH=
