# =============================================================================
# ilink_bot .env 模板（真实值不入库；复制为 .env 后按下方注释填全）
# 启动前 source 一下：set -a; source .env; set +a; ./bin/server -config config.local.yaml
# =============================================================================

# ---- 服务端 ----
ILINK_SERVER_ADDR=
ILINK_SERVER_MODE=

# ---- 腾讯 ima 知识库 OpenAPI（重要：与微信 APP_ID/API_KEY 无关，别看错）----
# 凭据来源：https://ima.qq.com/agent-interface  登录 → 创建智能体 → 拿 Client ID + API Key
# 任一为空时检索自动降级为无上下文，不影响服务启动
IMA_ILINK_BASE_URL=
IMA_ILINK_CLIENT_ID=
IMA_ILINK_API_KEY=
IMA_ILINK_DEFAULT_KB=
IMA_ILINK_TIMEOUT=
IMA_ILINK_SEARCH_LIMIT=
# 检索后用同一 LLM 二次排序，过滤关键词噪声；默认 0（关闭）；开 1/true/yes/on
IMA_ILINK_RERANK=
# rerank 后保留的命中条数（1~search_limit），默认 3
IMA_ILINK_RERANK_TOP_K=
# search 后逐条 get_doc_content 拿正文注入 prompt（绕过 highlight_content 空的问题；+1~3s 延迟）
IMA_ILINK_FETCH_BODY=
# search 前用 LLM 抽 1-3 个关键词（让"IMA是什么？"等自然问句能命中 KB；+1 次小 LLM 调用）
IMA_ILINK_KEYWORD_EXTRACT=

# ---- 内部 API 鉴权 ----
ILINK_AUTH_API_TOKEN=
ILINK_AUTH_BRIDGE_TOKEN=

# ---- 微信通道 ----
ILINK_WECHAT_DRIVER=

# official 驱动
ILINK_WECHAT_APP_ID=
ILINK_WECHAT_APP_SECRET=
ILINK_WECHAT_TOKEN=
ILINK_WECHAT_ENCODING_AES_KEY=

# ilink 驱动
ILINK_ILINK_BASE_URL=
ILINK_ILINK_TOKEN=
ILINK_ILINK_BOT_AGENT=
ILINK_ILINK_STATE_PATH=
ILINK_ILINK_ALLOW_LOGIN_FLOW=

# ---- 问答引擎 ----
ILINK_BRAIN_DRIVER=
ILINK_BRAIN_ENDPOINT=
ILINK_BRAIN_TOKEN=
ILINK_BRAIN_MODEL=

# ---- 会话存储 ----
ILINK_STORE_DRIVER=
ILINK_STORE_SQLITE_PATH=
